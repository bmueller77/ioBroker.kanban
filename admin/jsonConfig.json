    "webhookInTab": {
      "type": "panel",
      "label": {
        "en": "Webhooks (in)",
        "de": "Webhooks (eingehend)"
      },
      "items": {
        "_info": {
          "type": "staticText",
          "text": {
            "en": "External systems (scripts, AI agents, …) read and write cards via POST /webhook/<token>/action — see README for the command vocabulary. Each integration should get its own token.",
            "de": "Externe Systeme (Skripte, KI-Agenten, …) lesen und schreiben Karten via POST /webhook/<token>/action — Kommandos siehe README. Jede Integration sollte einen eigenen Token bekommen."
          },
          "sm": 12,
          "xs": 12,
          "lg": 12,
          "xl": 12
        },
        "generateToken": {
          "type": "sendTo",
          "command": "generateToken",
          "useNative": true,
          "variant": "contained",
          "label": {
            "en": "Generate new token",
            "de": "Neuen Token generieren"
          },
          "sm": 12,
          "md": 4,
          "xs": 12,
          "lg": 4,
          "xl": 4
        },
        "inboundTokens": {
          "type": "table",
          "label": {
            "en": "Tokens",
