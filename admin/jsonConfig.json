        "customCss": {
          "type": "text",
          "minRows": 4,
          "label": {
            "en": "Custom CSS",
            "de": "Eigenes CSS"
          },
          "help": {
            "en": "Loaded as last stylesheet in the board UI",
            "de": "Wird als letztes Stylesheet in der Board-Oberfläche geladen"
