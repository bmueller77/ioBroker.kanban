    "usersTab": {
      "type": "panel",
      "label": {
        "en": "Users",
        "de": "Benutzer"
      },
      "items": {
        "_info": {
          "type": "staticText",
          "text": {
            "en": "Users can be assigned to cards. No login — the user chips in the board header act as a filter.",
            "de": "Benutzer können Karten zugewiesen werden. Kein Login — die Benutzer-Chips in der Board-Kopfzeile dienen als Filter."
          },
          "sm": 12,
          "xs": 12,
          "lg": 12,
          "xl": 12
        },
        "users": {
          "type": "table",
          "label": {
            "en": "Users",
            "de": "Benutzer"
          },
          "sm": 12,
          "items": [
            {
              "type": "text",
              "attr": "name",
              "width": "10%",
              "title": {
                "en": "ID (lowercase)",
                "de": "ID (klein, ohne Umlaute)"
              },
              "filter": false,
              "sort": false
            },
            {
              "type": "text",
              "attr": "displayName",
              "width": "13%",
              "title": {
                "en": "Display name",
                "de": "Anzeigename"
              },
              "filter": false,
              "sort": false
            },
            {
              "type": "text",
              "attr": "email",
              "width": "22%",
              "title": {
                "en": "Email",
                "de": "E-Mail"
              },
              "filter": false,
              "sort": false
            },
            {
              "type": "checkbox",
              "attr": "notifyAssigned",
              "width": "6%",
              "title": {
                "en": "→ assigned",
                "de": "→ Zugew."
              },
              "tooltip": {
                "en": "E-mail when a card is assigned to this user",
                "de": "E-Mail, wenn diesem Benutzer eine Karte zugewiesen wird"
              },
              "filter": false,
              "sort": false
            },
            {
              "type": "checkbox",
              "attr": "notifyDue",
              "width": "6%",
              "title": {
                "en": "→ due",
                "de": "→ Fällig"
              },
              "tooltip": {
                "en": "E-mail when a card of this user is due/overdue",
                "de": "E-Mail, wenn eine Karte dieses Benutzers fällig/überfällig ist"
              },
              "filter": false,
              "sort": false
            },
            {
              "type": "checkbox",
              "attr": "notifyUpdated",
              "width": "6%",
              "title": {
                "en": "→ changed",
                "de": "→ Geänd."
              },
              "tooltip": {
                "en": "E-mail when a card of this user is edited",
                "de": "E-Mail, wenn eine Karte dieses Benutzers bearbeitet wird"
              },
              "filter": false,
              "sort": false
            },
            {
              "type": "checkbox",
              "attr": "notifyMoved",
              "width": "6%",
              "title": {
                "en": "→ moved",
                "de": "→ Versch."
              },
              "tooltip": {
                "en": "E-mail when a card is moved to another column",
                "de": "E-Mail, wenn eine Karte in eine andere Spalte verschoben wird"
              },
              "filter": false,
              "sort": false
            },
            {
              "type": "checkbox",
              "attr": "notifyDone",
              "width": "6%",
              "title": {
                "en": "→ done",
                "de": "→ Erled."
              },
              "tooltip": {
                "en": "E-mail when a card is marked done",
                "de": "E-Mail, wenn eine Karte als erledigt markiert wird"
              },
              "filter": false,
              "sort": false
            },
            {
              "type": "checkbox",
              "attr": "notifyCreated",
              "width": "6%",
              "title": {
                "en": "→ created",
                "de": "→ Neu"
              },
              "tooltip": {
                "en": "E-mail when a new card is created",
                "de": "E-Mail, wenn eine neue Karte erstellt wird"
              },
              "filter": false,
              "sort": false
            },
            {
              "type": "checkbox",
              "attr": "notifyDeleted",
              "width": "6%",
              "title": {
                "en": "→ trash",
                "de": "→ Papier."
              },
              "tooltip": {
                "en": "E-mail when a card of this user is moved to the trash (manually or by cleanup)",
                "de": "E-Mail, wenn eine Karte dieses Benutzers in den Papierkorb wandert (manuell oder durch Aufräumen)"
              },
              "filter": false,
              "sort": false
            },
            {
              "type": "checkbox",
              "attr": "notifyRestored",
              "width": "6%",
              "title": {
                "en": "→ restored",
                "de": "→ Wiederh."
              },
              "tooltip": {
                "en": "E-mail when a card of this user is restored from the trash",
                "de": "E-Mail, wenn eine Karte dieses Benutzers aus dem Papierkorb wiederhergestellt wird"
              },
              "filter": false,
              "sort": false
            },
            {
              "type": "checkbox",
              "attr": "notifyPurged",
              "width": "6%",
              "title": {
                "en": "→ deleted",
                "de": "→ Gelöscht"
              },
              "tooltip": {
                "en": "E-mail when a card of this user is permanently deleted",
                "de": "E-Mail, wenn eine Karte dieses Benutzers endgültig gelöscht wird"
              },
              "filter": false,
              "sort": false
            }
          ],
          "xs": 12,
          "lg": 12,
          "xl": 12
        },
        "_notifyLegend": {
          "type": "staticText",
          "format": "html",
          "text": {
            "en": "<div style='font-size:0.85rem;line-height:1.5;opacity:0.85'><b>What the columns mean</b><table style='border-collapse:collapse'><tr><td style='padding:1px 12px 1px 0;white-space:nowrap'><b>→ assigned</b></td><td>a card was assigned to this user, including later on an existing card</td></tr><tr><td style='padding:1px 12px 1px 0;white-space:nowrap'><b>→ due</b></td><td>an open card of this user is due, overdue or enters the configured days before the due date. The reminder repeats daily at the reminder time</td></tr><tr><td style='padding:1px 12px 1px 0;white-space:nowrap'><b>→ changed</b></td><td>a card of this user was edited</td></tr><tr><td style='padding:1px 12px 1px 0;white-space:nowrap'><b>→ moved</b></td><td>a card of this user was moved to another column</td></tr><tr><td style='padding:1px 12px 1px 0;white-space:nowrap'><b>→ done</b></td><td>a card of this user was marked done</td></tr><tr><td style='padding:1px 12px 1px 0;white-space:nowrap'><b>→ created</b></td><td>a new card was created on a board this user is a member of, no matter who it is assigned to. This also covers copies from another board and follow-up cards of a recurrence</td></tr><tr><td style='padding:1px 12px 1px 0;white-space:nowrap'><b>→ trash</b></td><td>a card of this user went to the trash, manually or through the automatic cleanup. It stays restorable for 30 days</td></tr><tr><td style='padding:1px 12px 1px 0;white-space:nowrap'><b>→ restored</b></td><td>a card of this user was restored from the trash</td></tr><tr><td style='padding:1px 12px 1px 0;white-space:nowrap'><b>→ deleted</b></td><td>a card of this user was deleted permanently after the 30 days</td></tr></table></div>",
            "de": "<div style='font-size:0.85rem;line-height:1.5;opacity:0.85'><b>Was die Spalten bedeuten</b><table style='border-collapse:collapse'><tr><td style='padding:1px 12px 1px 0;white-space:nowrap'><b>→ Zugew.</b></td><td>dem Benutzer wurde eine Karte zugewiesen, auch nachträglich bei einer bestehenden Karte</td></tr><tr><td style='padding:1px 12px 1px 0;white-space:nowrap'><b>→ Fällig</b></td><td>eine offene Karte des Benutzers ist fällig, überfällig oder rückt in die eingestellten Tage vor Fälligkeit. Die Erinnerung wiederholt sich täglich zur Erinnerungs-Uhrzeit</td></tr><tr><td style='padding:1px 12px 1px 0;white-space:nowrap'><b>→ Geänd.</b></td><td>eine Karte des Benutzers wurde bearbeitet</td></tr><tr><td style='padding:1px 12px 1px 0;white-space:nowrap'><b>→ Versch.</b></td><td>eine Karte des Benutzers wurde in eine andere Spalte verschoben</td></tr><tr><td style='padding:1px 12px 1px 0;white-space:nowrap'><b>→ Erled.</b></td><td>eine Karte des Benutzers wurde als erledigt markiert</td></tr><tr><td style='padding:1px 12px 1px 0;white-space:nowrap'><b>→ Neu</b></td><td>in einem Board, in dem der Benutzer Mitglied ist, wurde eine neue Karte angelegt, ganz gleich wer zuständig ist. Das gilt auch für Kopien aus einem anderen Board und für Folgekarten von Wiederholungen</td></tr><tr><td style='padding:1px 12px 1px 0;white-space:nowrap'><b>→ Papier.</b></td><td>eine Karte des Benutzers ist im Papierkorb gelandet, manuell oder durch das automatische Aufräumen. Dort bleibt sie 30 Tage wiederherstellbar</td></tr><tr><td style='padding:1px 12px 1px 0;white-space:nowrap'><b>→ Wiederh.</b></td><td>eine Karte des Benutzers wurde aus dem Papierkorb wiederhergestellt</td></tr><tr><td style='padding:1px 12px 1px 0;white-space:nowrap'><b>→ Gelöscht</b></td><td>eine Karte des Benutzers wurde nach den 30 Tagen endgültig gelöscht</td></tr></table></div>"
          },
          "sm": 12,
          "xs": 12,
          "lg": 12,
          "xl": 12
        },
        "_notifyInfo": {
          "type": "staticText",
          "text": {
            "en": "Leave a box unchecked to use the global default (Email tab). An e-mail is only sent if the user has an address and the Email tab is configured. Automatic cleanup runs are bundled into a single summary e-mail per user.",
            "de": "Nicht angehakt = globale Vorgabe (Tab „E-Mail\"). Eine E-Mail wird nur gesendet, wenn beim Benutzer eine Adresse hinterlegt und der E-Mail-Tab konfiguriert ist. Automatische Aufräumläufe werden zu einer Sammelmail je Benutzer gebündelt."
          },
          "sm": 12,
          "xs": 12,
          "lg": 12,
          "xl": 12
        }
      }
    },
    "emailTab": {
      "type": "panel",
      "label": {
        "en": "Email",
        "de": "E-Mail"
      },
      "items": {
        "emailInstance": {
          "type": "instance",
          "adapter": "email",
          "label": {
            "en": "Email adapter instance",
            "de": "email-Adapter-Instanz"
          },
          "sm": 6,
          "md": 4,
          "xs": 12,
          "lg": 4,
          "xl": 4
        },
        "emailFrom": {
          "type": "text",
          "label": {
            "en": "Sender address (empty = adapter default)",
            "de": "Absender (leer = Standard des email-Adapters)"
          },
          "sm": 6,
          "md": 4,
          "xs": 12,
          "lg": 4,
          "xl": 4
        },
        "_otherServicesHint": {
          "type": "staticText",
          "text": {
            "en": "Only e-mail is built in. Every other service is reached through the lastEvent state or an outbound webhook — the docs walk through it with a Telegram script you can copy.",
            "de": "Eingebaut ist nur E-Mail. Jeden anderen Dienst erreichst du über den lastEvent-State oder einen ausgehenden Webhook — die Doku zeigt das an einem Telegram-Skript zum Kopieren."
          },
          "sm": 12,
          "xs": 12,
          "lg": 12,
          "xl": 12
        },
        "_otherServicesLink": {
          "type": "staticLink",
          "label": {
            "en": "Send to Telegram, Pushover and others",
            "de": "An Telegram, Pushover und andere schicken"
          },
          "href": "https://github.com/bmueller77/iobroker.kanban/blob/main/docs/de/README.md#benachrichtigungen-an-beliebige-dienste-telegram-pushover-",
          "target": "_blank",
          "button": true,
          "variant": "outlined",
          "icon": "book",
          "sm": 12,
          "md": 6,
          "xs": 12,
          "lg": 6,
          "xl": 6
        },
        "reminderTime": {
          "type": "text",
          "label": {
            "en": "Reminder time (HH:MM)",
            "de": "Erinnerungs-Uhrzeit (HH:MM)"
          },
          "validator": "!data.reminderTime || /^([01]?\\d|2[0-3]):[0-5]\\d$/.test(data.reminderTime)",
          "validatorErrorText": "Format HH:MM",
          "sm": 6,
          "md": 2,
          "xs": 12,
          "lg": 2,
          "xl": 2
        },
        "reminderDaysBefore": {
          "type": "number",
          "min": 0,
          "max": 30,
          "label": {
            "en": "Remind X days before due",
            "de": "Erinnern X Tage vor Fälligkeit"
          },
          "sm": 6,
          "md": 2,
          "xs": 12,
          "lg": 2,
          "xl": 2
        },
        "dueExact": {
          "type": "checkbox",
          "label": {
            "en": "Fire \"card due\" at the card’s time of day",
            "de": "„Karte fällig\" zur Uhrzeit der Karte auslösen",
            "fr": "Déclencher « carte à échéance » à l’heure de la carte",
            "it": "Attiva «scheda in scadenza» all’ora della scheda",
            "nl": "\"Kaart vervalt\" op het tijdstip van de kaart activeren"
          },
          "help": {
            "en": "In addition to the daily reminder: cards with a time of day trigger cardDue exactly then (detail.exact = true). Note that this also sends a second \"due\" e-mail to everyone who has that notification enabled.",
            "de": "Zusätzlich zur täglichen Erinnerung: Karten mit Uhrzeit lösen cardDue genau dann aus (detail.exact = true). Achtung: Damit geht auch eine zweite „Fällig\"-E-Mail an alle raus, die diese Benachrichtigung aktiviert haben.",
            "fr": "En plus du rappel quotidien : les cartes avec une heure déclenchent cardDue à ce moment précis (detail.exact = true). Attention, un second e-mail « échéance » est alors également envoyé.",
            "it": "Oltre al promemoria giornaliero: le schede con un’ora attivano cardDue esattamente in quel momento (detail.exact = true). Attenzione: viene inviata anche una seconda e-mail di scadenza.",
            "nl": "Naast de dagelijkse herinnering: kaarten met een tijdstip activeren cardDue precies dan (detail.exact = true). Let op: er gaat dan ook een tweede \"vervalt\"-e-mail uit."
          },
          "sm": 12,
          "md": 8,
          "xs": 12,
          "lg": 8,
          "xl": 8
        },
        "_hdr": {
